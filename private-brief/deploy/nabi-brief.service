[Unit]
Description=Nabi private morning brief
After=network-online.target
Wants=network-online.target
[Service]
User=nabi-brief
Group=nabi-brief
WorkingDirectory=/opt/nabi-brief
EnvironmentFile=/etc/nabi-brief/environment
ExecStart=/opt/nabi-brief/.venv/bin/python -m brief serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nabi-brief
UMask=0077
[Install]
WantedBy=multi-user.target
