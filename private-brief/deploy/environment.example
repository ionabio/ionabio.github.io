# Copy outside repository to /etc/nabi-brief/environment with root-owned mode 0600.
# Fill using approved secret facility; never commit real values.
BRIEF_DATABASE=/var/lib/nabi-brief/state.sqlite
BRIEF_PUBLIC_ORIGIN=https://brief.nabi.be
BRIEF_SESSION_SECRET=REPLACE_WITH_APPROVED_RANDOM_SECRET
BRIEF_PASSWORD_HASH=REPLACE_WITH_APPROVED_SCRYPT_HASH
# Optional; disabled until approved VAPID setup and tested phone subscription.
BRIEF_VAPID_PUBLIC_KEY=
BRIEF_VAPID_PRIVATE_KEY=
BRIEF_VAPID_SUBJECT=
BRIEF_MEDIA_DIR=/var/lib/nabi-brief/media
